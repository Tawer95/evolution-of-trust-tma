# Шаблон окружения. Скопировать в .env и заполнить реальными значениями.
# .env в .gitignore — секреты в репозиторий не попадают.

# Токен Telegram-бота из @BotFather
BOT_TOKEN=

# Публичный HTTPS-URL Mini App (для web_app кнопки бота). На локали — HTTPS-туннель.
WEBAPP_URL=

# Подключение к Postgres (этап бэкенда/лидерборда)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/trust
